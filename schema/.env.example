# Server Rust
PORT=8080
DATABASE_PATH=../data/dapurku.db     # dijalankan dari folder server/
WEB_DIR=../web
KASIR_PIN=1111
DAPUR_PIN=2222
ADMIN_PIN=9999                        # WAJIB diganti
WEBHOOK_SECRET=ganti-dengan-string-acak
PAYMENT_MODE=sim                      # sim = tombol "sudah bayar" aktif; live = mati
TZ_OFFSET_MIN=420                     # WIB
BASE_URL=                             # isi mis. https://dapurku.example.com agar QR meja benar

